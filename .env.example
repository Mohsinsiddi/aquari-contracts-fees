# AQUARI Fee Enablement - Environment Variables
# Copy this to .env and fill in values

# Admin private key (owner of AQUARI token contract)
# This account must be the owner to call setTaxConfig() and setUniswapV2Pair()
ADMIN_KEY=your_private_key_here

# Optional: Custom RPC (defaults to public endpoint)
BASE_RPC=https://mainnet.base.org

# Optional: For contract verification
BASESCAN_API_KEY=your_basescan_api_key
